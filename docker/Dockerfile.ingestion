FROM python:3.12.2-slim-bookworm AS base

# Install system dependencies including curl for health probes
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Create non-privileged user (uid 10001, gid 10001) per security standard
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/bash -m appuser

WORKDIR /app

# Install uv for high-speed dependency resolution
COPY --from=ghcr.io/astral-sh/uv:0.4.18 /uv /uvx /bin/

# Copy project manifests and install dependencies
COPY pyproject.toml README.md ./
RUN uv pip install --system -e . && \
    python -m spacy download en_core_web_sm

# Copy source code and scripts
COPY src/ ./src/
COPY scripts/ ./scripts/

# Create data directory for SQLite ledger and ensure non-root ownership
RUN mkdir -p /data && chown -R 10001:10001 /data /app

# Switch to non-privileged user
USER 10001

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uvicorn", "warden_ingestion.main:app", "--host", "0.0.0.0", "--port", "8000"]
